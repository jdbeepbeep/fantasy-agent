# Copy this file to ".env" and fill in your real values.
# ".env" is already in .gitignore -- it will never be committed to GitHub.

# Shared ESPN auth (same for both leagues, since it's your one ESPN login)
ESPN_SWID={YOUR-SWID-HERE-INCLUDING-CURLY-BRACES}
ESPN_S2=your-espn-s2-value-here

# League 1
LEAGUE_1_ID=452318932
LEAGUE_1_NAME=League 1
LEAGUE_1_YEAR=2026

# League 2
LEAGUE_2_ID=1702863032
LEAGUE_2_NAME=League 2
LEAGUE_2_YEAR=2026

# Filled in later, once we get to the Claude + Twilio pieces
